# Flask Application Environment

# Local development defaults
APP_ENV=development
FLASK_ENV=development
SECRET_KEY=replace_with_a_random_secret_key_for_local_development

# Database
# Leave blank to use the application's default SQLite database.
DATABASE_URL=

# Frontend & Admin Variants
FRONTEND_VARIANT=cinematic
CINEMATIC_ENGINE=original
ADMIN_LOGIN_VARIANT=signal
DEMO_MODE=false

# Security & Proxy
TRUSTED_PROXY_COUNT=0
SITE_URL=http://127.0.0.1:5000

# Optional Email Notifications
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lumina.studio