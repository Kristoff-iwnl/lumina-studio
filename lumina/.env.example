# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database
# For development: SQLite (default)
# For production with persistent disk: sqlite:////mnt/data/lumina.db
# For PostgreSQL: postgresql://user:password@localhost:5432/lumina
DATABASE_URL=

# Session security (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False

# Rate limiting
# For production, use Redis: redis://localhost:6379
RATELIMIT_STORAGE_URL=memory://

# Email (optional, leave blank to disable enquiry email notifications)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lumina.studio
